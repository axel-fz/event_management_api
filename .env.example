# Node environment (development, production, test)
NODE_ENV=development

# Server port (local development)
PORT=3000

# Supabase PostgreSQL Connection Pooler URL (Transaction pooler on port 6543)
# Format: postgresql://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/[db]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_management_db?sslmode=disable

# Optional: Session pooler on port 5432 for running TypeORM migrations
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_management_db?sslmode=disable

# JWT Secret (minimum 32 characters required)
JWT_SECRET=replace_this_with_a_super_secret_key_at_least_32_characters_long

# JWT expiration time (e.g. 1d, 7d, 3600s)
JWT_EXPIRES_IN=1d

# Allowed CORS Origin (* or comma-separated origins)
CORS_ORIGIN=*

# Rate limiting (TTL in ms, max requests per TTL window)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60